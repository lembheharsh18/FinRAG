# FinRAG Backend Environment Variables
# Copy this file to .env and fill in your values

# ====== Application Settings ======
APP_NAME=FinRAG
APP_VERSION=2.0.0
DEBUG=true

# ====== LLM — Groq (preferred, free & fast) ======
# Get your API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ====== LLM — OpenAI (fallback) ======
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# ====== Google Gemini Embeddings ======
# Get your API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ====== Pinecone Vector Store ======
# Get your API key from https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=finrag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ====== ChromaDB (local dev fallback, used when Pinecone not set) ======
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=financial_documents

# ====== AWS S3 File Storage (optional) ======
# When not set, files are stored locally in ./uploads
AWS_ACCESS_KEY_ID=your_aws_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_here
AWS_S3_BUCKET_NAME=your_bucket_name_here
AWS_REGION=us-east-1

# ====== CORS Configuration ======
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","https://fin-rag-phi.vercel.app"]

# ====== File Upload ======
MAX_FILE_SIZE_MB=50
UPLOAD_DIRECTORY=./uploads

# ====== Firebase Authentication ======
AUTH_PROVIDER=firebase
AUTH_DISABLED=false
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or pass JSON string directly:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ====== Security ======
# Secret key for SHA256 webhook/API key verification
API_SECRET_KEY=your_secret_key_here

# ====== Rate Limiting ======
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_ANSWER=30/minute
